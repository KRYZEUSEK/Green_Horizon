    _satisfaction: 10
    _infrastructure: 0
    _order: 0
    _environment: 0
    _effectsDuration: 1
  - _description: "Osiedla nie sta\u0107 na organizacj\u0119 ani rozdanie zupy."
    _budget: 0
    _satisfaction: -5
    _infrastructure: 0
    _order: 5
    _environment: 0
    _effectsDuration: 1
  - _description: Aaa, klasyka! Zorganizujmy wydarzenia.
